{
    "name": "e2depth_evggs_si_grad_loss",
    "cuda": true,
    "gpu": 0,
    "save_dir": "saved/",
    "seed": 123,

    "arch": "E2VIDRecurrent",
    "model": {
        "num_bins": 5,
        "skip_type": "sum",
        "num_encoders": 3,
        "base_num_channels": 32,
        "num_residual_blocks": 2,
        "use_upsample_conv": true,
        "recurrent_block_type": "convlstm",
        "norm": "none"
    },

    "loss": {
        "type": "scale_invariant_loss",
        "config": {"weight": 1.0, "n_lambda": 1.0}
    },

    "grad_loss": {
        "weight": 0.5
    },

    "metrics": [
        "mse",
        "abs_rel_diff",
        "scale_invariant_error",
        "median_error"
    ],

    "trainer": {
        "epochs": 100,
        "sequence_length": 10,
        "save_dir": "saved/",
        "save_freq": 5,
        "verbosity": 2,
        "monitor": "val_loss",
        "monitor_mode": "min",
        "num_previews": 3,
        "num_val_previews": 3,
        "still_previews": true,
        "grid_loss": true
    },

    "optimizer_type": "Adam",
    "optimizer": {
        "lr": 0.0001,
        "weight_decay": 0,
        "amsgrad": true
    },

    "lr_scheduler_type": "ExponentialLR",
    "lr_scheduler_freq": 1000,
    "lr_scheduler": {
        "gamma": 1.0
    },

    "data_loader": {
        "train": {
            "type": "SequenceSynchronizedFramesEventsDataset",
            "base_folder": "/run/user/1001/gvfs/sftp:host=login.cvgl.lab,port=22332/datasets/feed_forward_event/Tartanair_tmp/indoor",
            "event_folder": "events",
            "depth_folder": "depth",
            "frame_folder": "rgb",
            "dataset_type": "evggs",
            "proba_pause_when_running": 0.0,
            "proba_pause_when_paused": 0.0,
            "step_size": 5,
            "clip_distance": 100.0,
            "scale_factor": 1.0,
            "inverse": false,
            "start_idx": 1

        },
        "validation": {
            "type": "SequenceSynchronizedFramesEventsDataset",
            "base_folder": "/run/user/1001/gvfs/sftp:host=login.cvgl.lab,port=22332/datasets/feed_forward_event/Tartanair_tmp/indoor",
            "event_folder": "events",
            "depth_folder": "depth",
            "frame_folder": "rgb",
            "dataset_type": "evggs",
            "proba_pause_when_running": 0.0,
            "proba_pause_when_paused": 0.0,
            "step_size": 5,
            "clip_distance": 100.0,
            "scale_factor": 1.0,
            "inverse": false,
            "start_idx": 1
        },
        "batch_size": 4,
        "shuffle": true,
        "num_workers": 4,
        "pin_memory": true
    }
}